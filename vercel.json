{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://alpha-ai-881d8.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...route].ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
